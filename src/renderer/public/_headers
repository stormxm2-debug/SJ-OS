/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(self), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# 자동 업데이트의 핵심 — 버전 표식은 브라우저·CDN 어디에도 캐시하지 않는다.
# (앱은 /version.json 을 주기적으로 읽어 새 배포를 감지한다. 이게 캐시되면 새 버전을 못 본다.)
/version.json
  Cache-Control: no-store, no-cache, must-revalidate

# 입구 파일(HTML)은 캐시하되 매번 서버에 최신인지 확인한다 → 새로고침하면 바로 새 번들을 가리킨다.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# 서비스 워커도 항상 최신으로.
/sw.js
  Cache-Control: no-cache

# 해시가 박힌 정적 파일(assets)은 내용이 바뀌면 파일명이 바뀌므로 영구 캐시해도 안전하다(속도↑).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
